{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feasibility-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_type", "schema_version", "normative", "metadata"],
  "properties": {
    "receipt_type": {"const": "feasibility"},
    "schema_version": {"const": 1},
    "normative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256",
        "config_sha256",
        "source_sha256",
        "processor_sha256",
        "fixture_sha256",
        "loss_source_sha256",
        "synthetic_target_sha256",
        "probe_sha256",
        "environment_sha256",
        "parent_environment_sha256",
        "environment",
        "model_contract_receipt_sha256",
        "parent_model_contract",
        "checkpoint_sha256",
        "checkpoint_state_sha256",
        "observed_shapes",
        "invariants",
        "ordered_losses",
        "state_digests",
        "comparison",
        "step",
        "checkpoint",
        "synthetic_labels",
        "runtime",
        "recipe",
        "timing",
        "vram",
        "resume_verified",
        "status",
        "errors"
      ],
      "properties": {
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "processor_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "loss_source_sha256": {"const": "01c6fe0bdc5965ccf71e7eabfc98a3d05101300bc69dc1773ae3f58ebd7d02e6"},
        "synthetic_target_sha256": {"const": "abffd232b48a8306af8a35e6e2bce3ad0afa92f6380508f47e9c22b90e87d198"},
        "probe_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "parent_environment_sha256": {"$ref": "#/$defs/sha256"},
        "environment": {"$ref": "#/$defs/environment_evidence"},
        "model_contract_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "parent_model_contract": {"type": "object"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_state_sha256": {"$ref": "#/$defs/sha256"},
        "observed_shapes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pixel_values", "pixel_mask"],
          "properties": {
            "pixel_values": {"type": "array", "minItems": 4, "items": {"type": "integer"}},
            "pixel_mask": {"type": "array", "minItems": 3, "items": {"type": "integer"}}
          }
        },
        "invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adamw_update",
            "batch_size_two",
            "bf16_autocast",
            "bf16_supported",
            "checkpoint_content_verified",
            "checkpoint_round_trip",
            "cublas_workspace_configured",
            "cudnn_benchmark_disabled",
            "canonical_environment",
            "deterministic_algorithms",
            "deterministic_fallback_absent",
            "exact_scipy",
            "finite_gradients",
            "finite_loss",
            "gradient_clip_0_1",
            "parameter_changed",
            "peak_allocated_vram_within_22_gib",
            "resume_state_verified",
            "seed_17",
            "synthetic_labels_only",
            "tf32_disabled"
          ],
          "properties": {
            "adamw_update": {"type": "boolean"},
            "batch_size_two": {"type": "boolean"},
            "bf16_autocast": {"type": "boolean"},
            "bf16_supported": {"type": "boolean"},
            "checkpoint_content_verified": {"type": "boolean"},
            "checkpoint_round_trip": {"type": "boolean"},
            "cublas_workspace_configured": {"type": "boolean"},
            "cudnn_benchmark_disabled": {"type": "boolean"},
            "canonical_environment": {"type": "boolean"},
            "deterministic_algorithms": {"type": "boolean"},
            "deterministic_fallback_absent": {"type": "boolean"},
            "exact_scipy": {"type": "boolean"},
            "finite_gradients": {"type": "boolean"},
            "finite_loss": {"type": "boolean"},
            "gradient_clip_0_1": {"type": "boolean"},
            "parameter_changed": {"type": "boolean"},
            "peak_allocated_vram_within_22_gib": {"type": "boolean"},
            "resume_state_verified": {"type": "boolean"},
            "seed_17": {"type": "boolean"},
            "synthetic_labels_only": {"type": "boolean"},
            "tf32_disabled": {"type": "boolean"}
          }
        },
        "ordered_losses": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "state_digests": {"$ref": "#/$defs/state_digests"},
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "ordered_loss_hex", "state_digests", "sha256"],
          "properties": {
            "rule": {"const": "float-hex-and-state-digests-sha256-v1"},
            "ordered_loss_hex": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "state_digests": {"$ref": "#/$defs/state_digests"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loss_hex", "gradient_norm", "finite_loss", "finite_gradients", "parameter_digest_rule", "trainable_parameter_count", "parameter_digest_before", "parameter_digest_after"],
          "properties": {
            "loss_hex": {"type": "string"},
            "gradient_norm": {"type": "number"},
            "finite_loss": {"type": "boolean"},
            "finite_gradients": {"type": "boolean"},
            "parameter_digest_rule": {"const": "ordered-trainable-named-parameters-sha256-v1"},
            "trainable_parameter_count": {"type": "integer"},
            "parameter_digest_before": {"$ref": "#/$defs/sha256"},
            "parameter_digest_after": {"$ref": "#/$defs/sha256"}
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file_sha256",
            "verified_file_sha256",
            "live_model_state_sha256_after_step",
            "state_sha256_before_save",
            "state_sha256_after_load",
            "state_digests_before_save",
            "state_digests_after_load",
            "state_digests_after_restore",
            "input_digests_verified"
          ],
          "properties": {
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "verified_file_sha256": {"$ref": "#/$defs/sha256"},
            "live_model_state_sha256_after_step": {"$ref": "#/$defs/sha256"},
            "state_sha256_before_save": {"$ref": "#/$defs/sha256"},
            "state_sha256_after_load": {"$ref": "#/$defs/sha256"},
            "state_digests_before_save": {"$ref": "#/$defs/state_digests"},
            "state_digests_after_load": {"$ref": "#/$defs/state_digests"},
            "state_digests_after_restore": {"$ref": "#/$defs/state_digests"},
            "input_digests_verified": {"type": "boolean"}
          }
        },
        "synthetic_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["item_ids", "class_labels", "boxes_per_image", "source"],
          "properties": {
            "item_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "class_labels": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
            },
            "boxes_per_image": {"type": "array", "minItems": 2, "items": {"type": "integer"}},
            "source": {"type": "string"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "device",
            "precision",
            "tf32",
            "cuda_matmul_allow_tf32",
            "cudnn_allow_tf32",
            "cudnn_benchmark",
            "deterministic_algorithms",
            "deterministic_debug_mode",
            "cublas_workspace_config",
            "bf16_supported",
            "bf16_autocast_enabled",
            "deterministic_fallback_detected"
          ],
          "properties": {
            "seed": {"type": "integer"},
            "device": {"type": "string", "pattern": "^cuda:[0-9]+$"},
            "precision": {"const": "bfloat16"},
            "tf32": {"type": "boolean"},
            "cuda_matmul_allow_tf32": {"type": "boolean"},
            "cudnn_allow_tf32": {"type": "boolean"},
            "cudnn_benchmark": {"type": "boolean"},
            "deterministic_algorithms": {"type": "boolean"},
            "deterministic_debug_mode": {"type": "integer"},
            "cublas_workspace_config": {"type": "string"},
            "bf16_supported": {"type": "boolean"},
            "bf16_autocast_enabled": {"type": "boolean"},
            "deterministic_fallback_detected": {"type": "boolean"}
          }
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed", "batch_size", "optimizer", "detector_learning_rate", "backbone_learning_rate", "weight_decay", "gradient_clip_norm", "fixture_set"],
          "properties": {
            "seed": {"type": "integer"},
            "batch_size": {"type": "integer"},
            "optimizer": {"type": "string"},
            "detector_learning_rate": {"type": "number"},
            "backbone_learning_rate": {"type": "number"},
            "weight_decay": {"type": "number"},
            "gradient_clip_norm": {"type": "number"},
            "fixture_set": {"type": "string"}
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "gpu_seconds", "checkpoint_write_seconds", "checkpoint_load_seconds"],
          "properties": {
            "wall_seconds": {"type": "number"},
            "gpu_seconds": {"type": "number"},
            "checkpoint_write_seconds": {"type": "number"},
            "checkpoint_load_seconds": {"type": "number"}
          }
        },
        "vram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peak_allocated_bytes", "peak_reserved_bytes", "allocated_limit_bytes"],
          "properties": {
            "peak_allocated_bytes": {"type": "integer"},
            "peak_reserved_bytes": {"type": "integer"},
            "allocated_limit_bytes": {"const": 23622320128}
          }
        },
        "resume_verified": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "run_id"],
      "properties": {
        "timestamp": {"type": "string"},
        "run_id": {"type": "string", "pattern": ".*\\S.*"},
        "receipt_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "selected_cuda", "parent_environment_sha256"],
      "properties": {
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "python", "uv", "scipy", "torch", "torchvision", "transformers", "pycocotools", "cuda_runtime", "gpu_name", "gpu_uuid", "driver", "os", "wsl", "container_image_digest", "runtime_image_digest", "tf32", "deterministic_algorithms", "bf16_supported", "data_root_unset"],
          "properties": {
            "schema_version": {"const": 1},
            "python": {"type": "string"},
            "uv": {"type": "string"},
            "scipy": {"type": "string"},
            "torch": {"type": "string"},
            "torchvision": {"type": "string"},
            "transformers": {"type": "string"},
            "pycocotools": {"type": "string"},
            "cuda_runtime": {"type": "string"},
            "gpu_name": {"type": "string"},
            "gpu_uuid": {"type": "string"},
            "driver": {"type": "string"},
            "os": {"type": "string"},
            "wsl": {"type": "boolean"},
            "container_image_digest": {"type": "string"},
            "runtime_image_digest": {"type": "string"},
            "tf32": {"type": "boolean"},
            "deterministic_algorithms": {"type": "boolean"},
            "bf16_supported": {"type": "boolean"},
            "data_root_unset": {"type": "boolean"}
          }
        },
        "selected_cuda": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cuda_available", "device_count", "selected_index", "selected_name", "selected_uuid", "selected_device"],
          "properties": {
            "cuda_available": {"type": "boolean"},
            "device_count": {"type": "integer", "minimum": 0},
            "selected_index": {"type": "integer", "minimum": 0},
            "selected_name": {"type": "string"},
            "selected_uuid": {"type": "string"},
            "selected_device": {"type": "string"}
          }
        },
        "parent_environment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "state_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "optimizer", "scheduler", "scaler", "rng", "sampler"],
      "properties": {
        "model": {"$ref": "#/$defs/sha256"},
        "optimizer": {"$ref": "#/$defs/sha256"},
        "scheduler": {"$ref": "#/$defs/sha256"},
        "scaler": {"$ref": "#/$defs/sha256"},
        "rng": {"$ref": "#/$defs/sha256"},
        "sampler": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
