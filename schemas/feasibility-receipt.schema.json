{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feasibility-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_type", "schema_version", "normative", "metadata"],
  "properties": {
    "receipt_type": {"const": "feasibility"},
    "schema_version": {"const": 3},
    "normative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_sha256", "config_sha256", "source_sha256", "processor_sha256",
        "fixture_sha256", "loss_source_sha256", "synthetic_target_sha256",
        "probe_sha256", "environment_sha256", "parent_environment_sha256",
        "environment", "model_contract_receipt_sha256", "parent_model_contract",
        "checkpoint_sha256", "checkpoint_state_sha256", "observed_shapes",
        "invariants", "ordered_losses", "state_digests", "allowlisted_backward",
        "deterministic_attention",
        "parameter_inventory", "update_groups", "exact_comparison", "step",
        "checkpoint", "synthetic_labels", "runtime", "recipe", "timing", "vram",
        "resume_verified", "status", "errors"
      ],
      "properties": {
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "processor_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "loss_source_sha256": {"const": "01c6fe0bdc5965ccf71e7eabfc98a3d05101300bc69dc1773ae3f58ebd7d02e6"},
        "synthetic_target_sha256": {"const": "abffd232b48a8306af8a35e6e2bce3ad0afa92f6380508f47e9c22b90e87d198"},
        "probe_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "parent_environment_sha256": {"$ref": "#/$defs/sha256"},
        "environment": {"$ref": "#/$defs/environment_evidence"},
        "model_contract_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "parent_model_contract": {"type": "object"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_state_sha256": {"$ref": "#/$defs/sha256"},
        "observed_shapes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pixel_values", "pixel_mask"],
          "properties": {
            "pixel_values": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
            "pixel_mask": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer"}}
          }
        },
        "invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adamw_update", "allowlisted_backward_verified", "batch_size_two",
            "bf16_autocast", "bf16_supported", "checkpoint_content_verified",
            "checkpoint_round_trip", "cublas_workspace_configured",
            "cudnn_benchmark_disabled", "canonical_environment",
            "deterministic_algorithms", "deterministic_attention_backend_restored",
            "deterministic_attention_math_only", "deterministic_attention_scope_verified",
            "deterministic_attention_source_verified", "exact_scipy", "finite_gradients",
            "finite_loss", "gradient_clip_0_1", "parameter_changed",
            "peak_allocated_vram_within_22_gib", "resume_state_verified", "seed_17",
            "strict_deterministic_error_mode_restored", "synthetic_labels_only",
            "tf32_disabled"
          ],
          "properties": {
            "adamw_update": {"type": "boolean"},
            "allowlisted_backward_verified": {"type": "boolean"},
            "batch_size_two": {"type": "boolean"},
            "bf16_autocast": {"type": "boolean"},
            "bf16_supported": {"type": "boolean"},
            "checkpoint_content_verified": {"type": "boolean"},
            "checkpoint_round_trip": {"type": "boolean"},
            "cublas_workspace_configured": {"type": "boolean"},
            "cudnn_benchmark_disabled": {"type": "boolean"},
            "canonical_environment": {"type": "boolean"},
            "deterministic_algorithms": {"type": "boolean"},
            "deterministic_attention_backend_restored": {"type": "boolean"},
            "deterministic_attention_math_only": {"type": "boolean"},
            "deterministic_attention_scope_verified": {"type": "boolean"},
            "deterministic_attention_source_verified": {"type": "boolean"},
            "exact_scipy": {"type": "boolean"},
            "finite_gradients": {"type": "boolean"},
            "finite_loss": {"type": "boolean"},
            "gradient_clip_0_1": {"type": "boolean"},
            "parameter_changed": {"type": "boolean"},
            "peak_allocated_vram_within_22_gib": {"type": "boolean"},
            "resume_state_verified": {"type": "boolean"},
            "seed_17": {"type": "boolean"},
            "strict_deterministic_error_mode_restored": {"type": "boolean"},
            "synthetic_labels_only": {"type": "boolean"},
            "tf32_disabled": {"type": "boolean"}
          }
        },
        "ordered_losses": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "state_digests": {"$ref": "#/$defs/state_digests"},
        "allowlisted_backward": {"$ref": "#/$defs/allowlisted_backward"},
        "deterministic_attention": {"$ref": "#/$defs/deterministic_attention"},
        "parameter_inventory": {
          "type": "array", "minItems": 2, "items": {"$ref": "#/$defs/parameter_inventory_entry"}
        },
        "update_groups": {"$ref": "#/$defs/update_groups"},
        "exact_comparison": {"$ref": "#/$defs/exact_comparison"},
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loss_hex", "gradient_norm", "finite_loss", "finite_gradients", "parameter_digest_rule", "trainable_parameter_count", "parameter_digest_before", "parameter_digest_after"],
          "properties": {
            "loss_hex": {"type": "string"},
            "gradient_norm": {"type": "number"},
            "finite_loss": {"type": "boolean"},
            "finite_gradients": {"type": "boolean"},
            "parameter_digest_rule": {"const": "ordered-trainable-named-parameters-sha256-v1"},
            "trainable_parameter_count": {"type": "integer", "minimum": 1},
            "parameter_digest_before": {"$ref": "#/$defs/sha256"},
            "parameter_digest_after": {"$ref": "#/$defs/sha256"}
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_sha256", "verified_file_sha256", "live_model_state_sha256_after_step", "state_sha256_before_save", "state_sha256_after_load", "state_digests_before_save", "state_digests_after_load", "state_digests_after_restore", "input_digests_verified"],
          "properties": {
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "verified_file_sha256": {"$ref": "#/$defs/sha256"},
            "live_model_state_sha256_after_step": {"$ref": "#/$defs/sha256"},
            "state_sha256_before_save": {"$ref": "#/$defs/sha256"},
            "state_sha256_after_load": {"$ref": "#/$defs/sha256"},
            "state_digests_before_save": {"$ref": "#/$defs/state_digests"},
            "state_digests_after_load": {"$ref": "#/$defs/state_digests"},
            "state_digests_after_restore": {"$ref": "#/$defs/state_digests"},
            "input_digests_verified": {"type": "boolean"}
          }
        },
        "synthetic_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["item_ids", "class_labels", "boxes_per_image", "source"],
          "properties": {
            "item_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
            "class_labels": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 1, "items": {"type": "integer"}}},
            "boxes_per_image": {"type": "array", "minItems": 2, "items": {"type": "integer"}},
            "source": {"type": "string"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed", "device", "precision", "tf32", "cuda_matmul_allow_tf32", "cudnn_allow_tf32", "cudnn_benchmark", "deterministic_algorithms", "deterministic_debug_mode", "cublas_workspace_config", "bf16_supported", "bf16_autocast_enabled", "allowlisted_grid_sample_backward", "strict_deterministic_error_mode_restored"],
          "properties": {
            "seed": {"const": 17},
            "device": {"type": "string", "pattern": "^cuda:[0-9]+$"},
            "precision": {"const": "bfloat16"},
            "tf32": {"const": false},
            "cuda_matmul_allow_tf32": {"const": false},
            "cudnn_allow_tf32": {"const": false},
            "cudnn_benchmark": {"const": false},
            "deterministic_algorithms": {"const": true},
            "deterministic_debug_mode": {"const": 2},
            "cublas_workspace_config": {"const": ":4096:8"},
            "bf16_supported": {"const": true},
            "bf16_autocast_enabled": {"const": true},
            "allowlisted_grid_sample_backward": {"const": true},
            "strict_deterministic_error_mode_restored": {"const": true}
          }
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed", "batch_size", "optimizer", "detector_learning_rate", "backbone_learning_rate", "weight_decay", "gradient_clip_norm", "fixture_set"],
          "properties": {
            "seed": {"const": 17},
            "batch_size": {"const": 2},
            "optimizer": {"const": "AdamW"},
            "detector_learning_rate": {"const": 0.0001},
            "backbone_learning_rate": {"const": 0.00001},
            "weight_decay": {"const": 0.0001},
            "gradient_clip_norm": {"const": 0.1},
            "fixture_set": {"const": "wave0-rtdetr-contract"}
          }
        },
        "timing": {
          "type": "object", "additionalProperties": false,
          "required": ["wall_seconds", "gpu_seconds", "checkpoint_write_seconds", "checkpoint_load_seconds"],
          "properties": {
            "wall_seconds": {"type": "number"}, "gpu_seconds": {"type": "number"},
            "checkpoint_write_seconds": {"type": "number"}, "checkpoint_load_seconds": {"type": "number"}
          }
        },
        "vram": {
          "type": "object", "additionalProperties": false,
          "required": ["peak_allocated_bytes", "peak_reserved_bytes", "allocated_limit_bytes"],
          "properties": {
            "peak_allocated_bytes": {"type": "integer"},
            "peak_reserved_bytes": {"type": "integer"},
            "allocated_limit_bytes": {"const": 23622320128}
          }
        },
        "resume_verified": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "run_id"],
      "properties": {
        "timestamp": {"type": "string"},
        "run_id": {"type": "string", "pattern": ".*\\S.*"},
        "receipt_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_hash_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "shape": {"type": "array", "items": {"type": "integer"}},
    "parameter_inventory_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "group_name", "shape", "dtype"],
      "properties": {
        "name": {"type": "string", "pattern": ".*\\S.*"},
        "group_name": {"enum": ["detector", "backbone"]},
        "shape": {"$ref": "#/$defs/shape"},
        "dtype": {"type": "string", "pattern": ".*\\S.*"}
      }
    },
    "model_state_inventory_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "shape", "dtype", "trainable"],
      "properties": {
        "name": {"type": "string", "pattern": ".*\\S.*"},
        "shape": {"$ref": "#/$defs/shape"},
        "dtype": {"type": "string", "pattern": ".*\\S.*"},
        "trainable": {"type": "boolean"}
      }
    },
    "optimizer_group": {
      "type": "object", "additionalProperties": false,
      "required": ["group_name", "learning_rate", "weight_decay"],
      "properties": {
        "group_name": {"enum": ["detector", "backbone"]},
        "learning_rate": {"type": "number"},
        "weight_decay": {"type": "number"}
      }
    },
    "update_group": {
      "type": "object", "additionalProperties": false,
      "required": ["l2_norm"],
      "properties": {"l2_norm": {"type": "number", "exclusiveMinimum": 0}}
    },
    "update_groups": {
      "type": "object", "additionalProperties": false,
      "required": ["detector", "backbone"],
      "properties": {
        "detector": {"$ref": "#/$defs/update_group"},
        "backbone": {"$ref": "#/$defs/update_group"}
      }
    },
    "allowlisted_backward": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_identifier", "expected_count", "observed_count", "raw_warnings", "warning_categories", "operation_identifiers", "source_hash_rule", "source_sha256", "strict_mode_restored"],
      "properties": {
        "operation_identifier": {"const": "grid_sampler_2d_backward_cuda"},
        "expected_count": {"const": 9},
        "observed_count": {"const": 9},
        "raw_warnings": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "string", "pattern": "^grid_sampler_2d_backward_cuda does not have a deterministic implementation.*"}},
        "warning_categories": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"const": "UserWarning"}},
        "operation_identifiers": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"const": "grid_sampler_2d_backward_cuda"}},
        "source_hash_rule": {"const": "python-source-lf-normalized-sha256-v1"},
        "source_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["torch_init", "torch_nn_functional", "transformers_modeling_rt_detr"],
          "properties": {
            "torch_init": {"const": "d9dfff4b75d46e4c75572200a3466b70231d05b0318e38ac1bd121789165fb49"},
            "torch_nn_functional": {"const": "27493186ee22f811b553e31d9c804d4d46716d1be62d034d731537f66f27ef19"},
            "transformers_modeling_rt_detr": {"const": "fce24c79c8599e52f3648f549502879e9b396cc86f593c3a07baf10c002cead3"}
          }
        },
        "strict_mode_restored": {"const": true}
      }
    },
    "sdpa_backend_state": {
      "type": "object", "additionalProperties": false,
      "required": ["cudnn", "flash", "math", "memory_efficient"],
      "properties": {
        "cudnn": {"type": "boolean"},
        "flash": {"type": "boolean"},
        "math": {"type": "boolean"},
        "memory_efficient": {"type": "boolean"}
      }
    },
    "deterministic_attention": {
      "type": "object", "additionalProperties": false,
      "const": {
        "attn_implementation": "sdpa",
        "backend": "MATH",
        "scope": "labeled_forward_through_backward",
        "before": {"cudnn": true, "flash": true, "math": true, "memory_efficient": true},
        "inside": {"cudnn": false, "flash": false, "math": true, "memory_efficient": false},
        "after": {"cudnn": true, "flash": true, "math": true, "memory_efficient": true},
        "restored": true,
        "source_hash_rule": "python-source-lf-normalized-sha256-v1",
        "source_sha256": {
          "torch_nn_attention": "56e10b6f965cc050db782dd4dc472097c9b02ec5b5fe3ab2c8b04055c0b0bbe0",
          "transformers_sdpa_attention": "d334e0b1d0c17ac97964348e49e6df681a4193241c8161f23292817ca39e2098"
        }
      },
      "required": ["attn_implementation", "backend", "scope", "before", "inside", "after", "restored", "source_hash_rule", "source_sha256"],
      "properties": {
        "attn_implementation": {"const": "sdpa"},
        "backend": {"const": "MATH"},
        "scope": {"const": "labeled_forward_through_backward"},
        "before": {"$ref": "#/$defs/sdpa_backend_state"},
        "inside": {"$ref": "#/$defs/sdpa_backend_state"},
        "after": {"$ref": "#/$defs/sdpa_backend_state"},
        "restored": {"const": true},
        "source_hash_rule": {"const": "python-source-lf-normalized-sha256-v1"},
        "source_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["torch_nn_attention", "transformers_sdpa_attention"],
          "properties": {
            "torch_nn_attention": {"const": "56e10b6f965cc050db782dd4dc472097c9b02ec5b5fe3ab2c8b04055c0b0bbe0"},
            "transformers_sdpa_attention": {"const": "d334e0b1d0c17ac97964348e49e6df681a4193241c8161f23292817ca39e2098"}
          }
        }
      }
    },
    "replay_state_digests": {
      "type": "object", "additionalProperties": false,
      "required": ["scheduler", "scaler", "rng", "sampler"],
      "properties": {
        "scheduler": {"$ref": "#/$defs/sha256"}, "scaler": {"$ref": "#/$defs/sha256"},
        "rng": {"$ref": "#/$defs/sha256"}, "sampler": {"$ref": "#/$defs/sha256"}
      }
    },
    "exact_comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "parameter_digest_before", "parameter_inventory", "ordered_loss_hex", "optimizer_groups", "scheduler_state_before_sha256", "sampler_order_digest", "semantic_input_digests", "checkpoint_epoch", "checkpoint_step", "model_state_inventory", "state_digests", "allowlisted_backward", "deterministic_attention", "sha256"],
      "properties": {
        "rule": {"const": "wave0-a3-exact-replay-sha256-v1"},
        "parameter_digest_before": {"$ref": "#/$defs/sha256"},
        "parameter_inventory": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/parameter_inventory_entry"}},
        "ordered_loss_hex": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "optimizer_groups": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/optimizer_group"}},
        "scheduler_state_before_sha256": {"$ref": "#/$defs/sha256"},
        "sampler_order_digest": {"$ref": "#/$defs/sha256"},
        "semantic_input_digests": {
          "type": "object", "additionalProperties": false,
          "required": ["fixture_sha256", "synthetic_target_sha256"],
          "properties": {
            "fixture_sha256": {"$ref": "#/$defs/sha256"},
            "synthetic_target_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "checkpoint_epoch": {"const": 0},
        "checkpoint_step": {"const": 1},
        "model_state_inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_state_inventory_entry"}},
        "state_digests": {"$ref": "#/$defs/replay_state_digests"},
        "allowlisted_backward": {"$ref": "#/$defs/allowlisted_backward"},
        "deterministic_attention": {"$ref": "#/$defs/deterministic_attention"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "state_digests": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "optimizer", "scheduler", "scaler", "rng", "sampler"],
      "properties": {
        "model": {"$ref": "#/$defs/sha256"}, "optimizer": {"$ref": "#/$defs/sha256"},
        "scheduler": {"$ref": "#/$defs/sha256"}, "scaler": {"$ref": "#/$defs/sha256"},
        "rng": {"$ref": "#/$defs/sha256"}, "sampler": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["observed", "selected_cuda", "parent_environment_sha256"],
      "properties": {
        "observed": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "python", "uv", "scipy", "torch", "torchvision", "transformers", "pycocotools", "cuda_runtime", "gpu_name", "gpu_uuid", "driver", "os", "wsl", "container_image_digest", "runtime_image_digest", "tf32", "deterministic_algorithms", "bf16_supported", "data_root_unset"],
          "properties": {
            "schema_version": {"const": 1}, "python": {"type": "string"}, "uv": {"type": "string"},
            "scipy": {"type": "string"}, "torch": {"type": "string"}, "torchvision": {"type": "string"},
            "transformers": {"type": "string"}, "pycocotools": {"type": "string"}, "cuda_runtime": {"type": "string"},
            "gpu_name": {"type": "string"}, "gpu_uuid": {"type": "string"}, "driver": {"type": "string"},
            "os": {"type": "string"}, "wsl": {"type": "boolean"}, "container_image_digest": {"type": "string"},
            "runtime_image_digest": {"type": "string"}, "tf32": {"type": "boolean"},
            "deterministic_algorithms": {"type": "boolean"}, "bf16_supported": {"type": "boolean"},
            "data_root_unset": {"type": "boolean"}
          }
        },
        "selected_cuda": {
          "type": "object", "additionalProperties": false,
          "required": ["cuda_available", "device_count", "selected_index", "selected_name", "selected_uuid", "selected_device"],
          "properties": {
            "cuda_available": {"type": "boolean"}, "device_count": {"type": "integer"},
            "selected_index": {"type": "integer"}, "selected_name": {"type": "string"},
            "selected_uuid": {"type": "string"}, "selected_device": {"type": "string"}
          }
        },
        "parent_environment_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
