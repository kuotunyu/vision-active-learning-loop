{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feasibility-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_type", "schema_version", "normative", "metadata"],
  "properties": {
    "receipt_type": {"const": "feasibility"},
    "schema_version": {"const": 1},
    "normative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_sha256", "config_sha256", "source_sha256", "processor_sha256", "fixture_sha256", "probe_sha256", "environment_sha256", "observed_shapes", "invariants", "status", "errors", "ordered_losses", "state_digests", "runtime", "resume_verified"],
      "properties": {
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "processor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "probe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_shapes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "integer"}}},
        "invariants": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
        "status": {"enum": ["PASS", "FAIL"]},
        "errors": {"type": "array", "items": {"type": "string"}},
        "ordered_losses": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "state_digests": {"type": "object", "additionalProperties": false, "required": ["model", "optimizer", "scheduler", "scaler", "rng", "sampler"], "properties": {"model": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "optimizer": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scheduler": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scaler": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rng": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sampler": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "runtime": {"type": "object", "additionalProperties": false, "required": ["tf32", "deterministic_algorithms", "bf16_supported"], "properties": {"tf32": {"type": "boolean"}, "deterministic_algorithms": {"type": "boolean"}, "bf16_supported": {"type": "boolean"}}},
        "resume_verified": {"type": "boolean"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timestamp": {"type": "string"},
        "run_id": {"type": "string"},
        "temporary_directory": {"type": "string"},
        "container_instance_id": {"type": "string"},
        "receipt_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
